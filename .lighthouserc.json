{
  "ci": {
    "collect": {
      "numberOfRuns": 2,
      "startServerCommand": "npm run preview -- --host 127.0.0.1 --port 4173 --strictPort",
      "startServerReadyPattern": "Local|127\\.0\\.0\\.1:4173",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/#/about",
        "http://127.0.0.1:4173/#/experience",
        "http://127.0.0.1:4173/#/projects",
        "http://127.0.0.1:4173/#/skills",
        "http://127.0.0.1:4173/#/education",
        "http://127.0.0.1:4173/#/certifications",
        "http://127.0.0.1:4173/#/contact"
      ],
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.85 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 2800 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 3600 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}

